   "audio_syl": 7,
   "text_syl": 8
  },
  {
   "start": 5.93,
   "end": 7.83,
   "phrases": [
    "അവിടെ വെച്ചാണ് ഫ്രണ്ട് എന്റെ ചുണ്ട് കണ്ടത്"
